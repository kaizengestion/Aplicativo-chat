# Conexión con permisos de dueño (solo para correr migraciones). En Supabase: Project Settings > Database > Connection string (rol postgres).
ADMIN_DATABASE_URL=postgres://postgres:postgres@localhost:5432/chatapp

# Conexión que usa la app, con el rol restringido chat_app (lo crea la migración). RLS aplica a este rol.
DATABASE_URL=postgres://chat_app:cambia-esta-clave@localhost:5432/chatapp
# Clave que la migración asigna al rol chat_app (debe coincidir con DATABASE_URL)
APP_DB_PASSWORD=cambia-esta-clave

# Secreto para firmar la sesión del tablero (cadena larga aleatoria)
SESSION_SECRET=cambia-esto-por-una-cadena-larga-aleatoria

# Clave de la API de Claude. Sin ella el bot responde en modo demo.
ANTHROPIC_API_KEY=

# URL pública de la app (para armar el enlace de WhatsApp)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Avisos por correo (pasar a persona, recuperar contraseña). Opcional. Con SMTP_HOST se usa SMTP;
# si no, Resend (https://resend.com) con RESEND_API_KEY.
NOTIFY_FROM=Avisos <avisos@tudominio.com>
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
RESEND_API_KEY=

# Transcripción de audios del chat (opcional). Groq tiene plan gratis: https://console.groq.com/keys
# Si no hay ninguna, los audios se guardan y se escuchan, pero el bot pide que lo escriban. Se usa Groq si están las dos.
GROQ_API_KEY=
OPENAI_API_KEY=
