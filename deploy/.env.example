# Copiar a deploy/.env en el servidor (chmod 600). Nunca subir deploy/.env a git ni pegar estas claves en un chat.

# Dirección pública (la que va en WhatsApp)
NEXT_PUBLIC_APP_URL=https://chat.kaizengestion.com

# Puertos en el servidor: la app (Caddy la busca acá por Tailscale) y la base (solo 127.0.0.1)
APP_PORT=8020
DB_PORT=5434

# Claves de la base nueva: generar con  openssl rand -hex 24
DB_ADMIN_PASSWORD=
APP_DB_PASSWORD=

# Firma de las sesiones del tablero: openssl rand -hex 32  (una nueva cierra las sesiones abiertas)
SESSION_SECRET=

# Claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=

# Correo saliente por Google Workspace (contraseña de aplicación de administracion@, alias soporte@)
NOTIFY_FROM="Chat de ayuda Kaizen <soporte@kaizengestion.com>"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=administracion@kaizengestion.com
SMTP_PASSWORD=

# Transcripción de audios en el servidor (opcional)
GROQ_API_KEY=
OPENAI_API_KEY=
